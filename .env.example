# 天气请求超时（毫秒）。超时后使用六小时内的本地缓存，
# 若缓存也不可用，则仅依据节日、节气、季节和时间推荐。
VITE_WEATHER_TIMEOUT_MS=1100

# 可选内容撤回清单网关。正式环境只允许 HTTPS；试用版可使用本机回环地址演练。
# VITE_CONTENT_CONTROL_URL=http://127.0.0.1:8788/v1/content-withdrawals
VITE_CONTENT_CONTROL_TIMEOUT_MS=2500

# 可选的受控 AI 理由服务。未配置、超时或响应校验失败时，
# 应用会立即使用本地规则生成的预设理由。
# VITE_REASON_API_URL=http://127.0.0.1:8787/reason
VITE_REASON_TIMEOUT_MS=2500
