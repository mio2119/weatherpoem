{
  "name": "weatherpoem",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "根据节日、天气与节气推荐可信诗词的低打扰桌面应用",
  "weatherPoem": {
    "releaseChannel": "trial"
  },
  "scripts": {
    "dev": "vite --port 1420",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "content:check": "vitest run src/data/content-validation.test.ts",
    "content:review:export": "node scripts/export-content-review.mjs",
    "content:review:check": "node scripts/export-content-review.mjs --check && node --test scripts/content-review-contract.test.mjs",
    "content:review:validate": "node scripts/validate-content-review.mjs",
    "redesign:h1:preflight": "node --test scripts/redesign-h1-preflight.test.mjs",
    "content:withdrawal:drill": "node scripts/content-withdrawal-drill.mjs",
    "content:withdrawal:check": "node scripts/content-withdrawal-drill.mjs --check && node --test scripts/content-withdrawal-contract.test.mjs",
    "content:withdrawal:redesign:check": "node scripts/content-withdrawal-drill.mjs --check --report=T08_CONTENT_WITHDRAWAL_DRILL_CONTENT101_20261020.json && node --test scripts/content-withdrawal-contract.test.mjs",
    "device:matrix:check": "node --test scripts/device-matrix-contract.test.mjs",
    "desktop:capability:check": "node --test scripts/desktop-capability-contract.test.mjs",
    "performance:smoke": "powershell.exe -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -File scripts/test-performance-smoke.ps1",
    "performance:smoke:redesign": "powershell.exe -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -File scripts/test-performance-smoke.ps1 -RedesignCandidate",
    "performance:smoke:redesign:check": "node scripts/performance-smoke-check.mjs --redesign-candidate",
    "performance:motion:redesign": "powershell.exe -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -File scripts/test-redesign-motion-resource.ps1",
    "performance:motion:redesign:check": "node scripts/redesign-motion-resource-check.mjs",
    "performance:motion:system-reduced": "node scripts/test-redesign-system-reduced-motion.mjs",
    "performance:motion:system-reduced:check": "node scripts/test-redesign-system-reduced-motion.mjs --check",
    "performance:smoke:baseline-comparison": "powershell.exe -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -File scripts/test-performance-smoke.ps1 -BaselineComparison",
    "performance:smoke:baseline-comparison:check": "node scripts/performance-smoke-check.mjs --baseline-comparison",
    "performance:fault-matrix": "node scripts/performance-fault-matrix.mjs",
    "performance:fault-matrix:redesign": "node scripts/performance-fault-matrix.mjs --redesign-candidate",
    "performance:fault-matrix:redesign:check": "node scripts/performance-fault-matrix-check.mjs --redesign-candidate",
    "performance:fault-matrix:check": "node scripts/performance-fault-matrix-check.mjs && node --test scripts/performance-fault-matrix-contract.test.mjs",
    "performance:long-run": "powershell.exe -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -File scripts/test-performance-long-run.ps1",
    "performance:long-run:rehearsal": "powershell.exe -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -File scripts/test-performance-long-run.ps1 -DurationMinutes 2 -SampleIntervalSeconds 5 -Rehearsal",
    "performance:long-run:check": "node scripts/performance-long-run-check.mjs && node --test scripts/performance-long-run-contract.test.mjs scripts/performance-eight-hour-contract.test.mjs scripts/performance-seven-day-contract.test.mjs scripts/performance-seven-day-sampler-preflight.test.mjs scripts/performance-seven-day-launcher-preflight.test.mjs scripts/performance-seven-day-status-support.test.mjs",
    "performance:eight-hour:start": "powershell.exe -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -File scripts/start-performance-eight-hour.ps1",
    "performance:eight-hour:status": "node scripts/performance-eight-hour-status.mjs",
    "performance:eight-hour:check": "node scripts/performance-eight-hour-check.mjs && node --test scripts/performance-eight-hour-contract.test.mjs",
    "performance:seven-day:start": "powershell.exe -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -File scripts/start-performance-seven-day.ps1",
    "performance:seven-day:status": "node scripts/performance-seven-day-status.mjs",
    "performance:seven-day:check": "node scripts/performance-seven-day-check.mjs && node --test scripts/performance-seven-day-contract.test.mjs scripts/performance-seven-day-sampler-preflight.test.mjs scripts/performance-seven-day-launcher-preflight.test.mjs scripts/performance-seven-day-status-support.test.mjs",
    "performance:check": "node scripts/performance-smoke-check.mjs && node --test scripts/performance-smoke-contract.test.mjs scripts/performance-profile-seed.test.mjs && npm run performance:fault-matrix:check && npm run performance:long-run:check",
    "accessibility:check": "node scripts/accessibility-check.mjs && node --test scripts/accessibility-contract.test.mjs",
    "pilot:check": "node scripts/pilot-plan-check.mjs && node --test scripts/pilot-plan-contract.test.mjs",
    "pilot:four-week:generate": "node scripts/generate-four-week-pilot-plan.mjs",
    "pilot:four-week:check": "node scripts/four-week-pilot-plan-check.mjs && node --test scripts/four-week-pilot-plan-contract.test.mjs",
    "scope:freeze:generate": "node scripts/generate-scope-freeze-proposal.mjs",
    "scope:freeze:check": "node scripts/scope-freeze-check.mjs && node --test scripts/scope-freeze-contract.test.mjs",
    "uat:plan:generate": "node scripts/generate-release-uat-plan.mjs",
    "uat:plan:check": "node scripts/release-uat-check.mjs && node --test scripts/release-uat-contract.test.mjs",
    "updater:plan:generate": "node scripts/generate-signed-updater-plan.mjs",
    "updater:plan:check": "node scripts/signed-updater-plan-check.mjs && node --test scripts/signed-updater-plan-contract.test.mjs",
    "distribution:plan:generate": "node scripts/generate-public-distribution-plan.mjs",
    "distribution:plan:check": "node scripts/public-distribution-plan-check.mjs && node --test scripts/public-distribution-plan-contract.test.mjs",
    "signing:plan:generate": "node scripts/generate-code-signing-plan.mjs",
    "signing:plan:check": "node scripts/code-signing-plan-check.mjs && node --test scripts/code-signing-plan-contract.test.mjs",
    "licenses:generate": "node scripts/generate-license-inventory.mjs",
    "licenses:notices:sync": "node scripts/sync-npm-license-texts.mjs",
    "licenses:notices:sync:cargo": "node scripts/sync-cargo-license-texts.mjs",
    "licenses:notices:sync:spdx": "node scripts/sync-spdx-license-texts.mjs",
    "licenses:notices:generate": "node scripts/generate-third-party-notices.mjs",
    "licenses:notices:check": "node scripts/third-party-notices-check.mjs && node --test scripts/third-party-notices-contract.test.mjs",
    "licenses:notices:installed:check": "node scripts/installed-notice-check.mjs && node --test scripts/installed-notice-contract.test.mjs scripts/installed-notice-command-contract.test.mjs",
    "licenses:check": "node scripts/license-inventory-check.mjs && node --test scripts/license-inventory-contract.test.mjs && npm run licenses:notices:check",
    "requirements:generate": "node scripts/generate-project-readiness.mjs",
    "requirements:check": "node scripts/generate-project-readiness.mjs --check && node --test scripts/project-readiness-contract.test.mjs scripts/product-requirements-contract.test.mjs",
    "requirements:pilot": "node scripts/generate-project-readiness.mjs --check --require campus-pilot && npm run check && npm run release:verify:manual-windows && npm run release:verify:upgrade",
    "requirements:public": "node scripts/generate-project-readiness.mjs --check --require public-release && npm run check && npm run release:verify:production",
    "reason:catalog": "node scripts/export-reason-catalog.mjs",
    "reason:eval:catalog": "node scripts/export-reason-evals.mjs",
    "reason:eval:check": "node scripts/export-reason-evals.mjs --check && node --test server/reason-eval.test.mjs",
    "reason:eval:run": "node scripts/run-reason-evals.mjs",
    "reason:eval:review": "node scripts/validate-reason-eval-review.mjs",
    "reason:check": "node scripts/export-reason-catalog.mjs --check && node scripts/export-reason-evals.mjs --check && node --test server/*.test.mjs",
    "security:audit": "node scripts/dependency-audit.mjs",
    "security:cargo-audit": "powershell.exe -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -File scripts/native-cargo-audit.ps1",
    "security:cargo-audit:check": "node scripts/native-cargo-audit-check.mjs && node --test scripts/native-cargo-audit-contract.test.mjs",
    "security:dependency-review": "node scripts/generate-dependency-risk-review.mjs",
    "security:dependency-review:check": "node scripts/dependency-risk-review-check.mjs && node --test scripts/dependency-risk-review-contract.test.mjs",
    "security:audit:check": "node scripts/dependency-audit.mjs --check && npm run security:cargo-audit:check && npm run security:dependency-review:check",
    "reason:start": "node server/index.mjs",
    "release:checksums": "node scripts/generate-release-checksums.mjs",
    "release:manifest": "node scripts/generate-release-manifest.mjs",
    "release:manifest:check": "node scripts/generate-release-manifest.mjs --check && node --test scripts/release-support.test.mjs scripts/windows-manual-evidence-contract.test.mjs scripts/installed-notice-contract.test.mjs scripts/installed-notice-command-contract.test.mjs",
    "release:verify": "node scripts/generate-release-manifest.mjs --check && node --test scripts/release-support.test.mjs scripts/windows-manual-evidence-contract.test.mjs scripts/installed-notice-contract.test.mjs scripts/installed-notice-command-contract.test.mjs && node scripts/verify-release.mjs",
    "release:verify:manual-windows": "node scripts/generate-release-manifest.mjs --check && node --test scripts/release-support.test.mjs scripts/windows-manual-evidence-contract.test.mjs scripts/installed-notice-contract.test.mjs scripts/installed-notice-command-contract.test.mjs && node scripts/verify-release.mjs --manual-windows",
    "release:verify:upgrade": "node scripts/generate-release-manifest.mjs --check && node --test scripts/release-support.test.mjs scripts/windows-manual-evidence-contract.test.mjs scripts/installed-notice-contract.test.mjs scripts/installed-notice-command-contract.test.mjs && node scripts/verify-release.mjs --upgrade",
    "release:verify:production": "node scripts/generate-release-manifest.mjs --check && node --test scripts/release-support.test.mjs scripts/windows-manual-evidence-contract.test.mjs scripts/installed-notice-contract.test.mjs scripts/installed-notice-command-contract.test.mjs && node scripts/verify-release.mjs --production",
    "release:test:nsis": "powershell.exe -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -File scripts/test-nsis-lifecycle.ps1",
    "release:test:msi-image": "powershell.exe -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -File scripts/test-msi-image.ps1",
    "release:test:msi-elevated": "powershell.exe -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -File scripts/test-msi-elevated-lifecycle.ps1",
    "release:test:nsis-upgrade": "powershell.exe -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -File scripts/test-nsis-upgrade-rollback.ps1",
    "release:test:autostart-reboot": "powershell.exe -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -File scripts/test-autostart-reboot.ps1",
    "release:test:single-instance": "powershell.exe -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -File scripts/test-single-instance.ps1",
    "release:test:window-position": "powershell.exe -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -File scripts/test-window-position.ps1",
    "check": "npm run lint && npm run typecheck && npm run test && npm run content:review:check && npm run content:withdrawal:redesign:check && npm run device:matrix:check && npm run desktop:capability:check && npm run performance:check && npm run accessibility:check && npm run pilot:check && npm run pilot:four-week:check && npm run scope:freeze:check && npm run uat:plan:check && npm run signing:plan:check && npm run updater:plan:check && npm run distribution:plan:check && npm run licenses:check && npm run reason:check && npm run security:audit:check && npm run requirements:check && npm run build",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-autostart": "^2.5.1",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "@tauri-apps/plugin-sql": "^2.4.0",
    "lunar-typescript": "^1.8.6",
    "vue": "^3.5.40"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.3",
    "@types/node": "^26.1.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.4.11",
    "eslint": "^10.7.0",
    "eslint-plugin-vue": "^10.10.0",
    "happy-dom": "^20.11.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.8"
  },
  "engines": {
    "node": ">=22"
  }
}
