{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WeatherPoem",
  "version": "0.2.0",
  "identifier": "cn.weatherpoem.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "WeatherPoem 今日诗笺",
        "width": 430,
        "height": 680,
        "minWidth": 320,
        "minHeight": 260,
        "resizable": false,
        "fullscreen": false,
        "decorations": false,
        "transparent": false,
        "center": true,
        "visible": false,
        "focus": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost http://localhost:* http://127.0.0.1:* ws://localhost:* https://api.open-meteo.com; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "category": "Education",
    "shortDescription": "每天一首与今日情境有关的可信诗词",
    "longDescription": "WeatherPoem 根据当地节日、天气与节气，在每天第一次进入电脑桌面时推荐一首可追溯的中国古典诗词。",
    "resources": {
      "../docs/THIRD_PARTY_NOTICES.md": "licenses/THIRD_PARTY_NOTICES.md"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
